    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.24.1",
    "@tarojs/cli": "4.2.1",
    "@types/react": "18.3.12",
    "babel-preset-taro": "4.2.1",
    "react-refresh": "^0.14.0",
