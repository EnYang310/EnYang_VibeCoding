# Choose one option. This file is safe to commit; never commit the real .env.
MOONSHOT_API_KEY=
# Or reference an existing local key file (keeps the key out of this project):
KIMI_SHARED_KEY_PATH=
KIMI_MODEL=kimi-k2.6
# Optional for split frontend/backend local development. Production is same-origin.
CORS_ALLOWED_ORIGINS=http://localhost:10086,http://127.0.0.1:10086
# Tencent Cloud injects this automatically in many runtimes; defaults to 8000.
PORT=8000
# Per-instance protection for the paid model endpoint.
CHAT_RATE_LIMIT_PER_MINUTE=30
# Tencent Cloud Text-to-Speech: keep these server-side only.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_TTS_REGION=ap-guangzhou
TENCENT_TTS_VOICE_TYPE=101001
VOICE_RATE_LIMIT_PER_MINUTE=20
